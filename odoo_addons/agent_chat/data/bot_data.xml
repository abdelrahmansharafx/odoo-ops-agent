<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- A normal internal user with no password, so it appears in chat but cannot log in. -->
    <record id="user_business_agent" model="res.users">
        <field name="name">Business Agent</field>
        <field name="login">business_agent</field>
        <field name="email">business.agent@example.com</field>
        <field name="notification_type">inbox</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>
</odoo>
