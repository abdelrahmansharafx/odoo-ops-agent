<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="agent_chat.AiSystray">
        <div class="o_agent_ai_systray">
            <button class="o_agent_ai_btn btn btn-link" t-on-click="onClick" title="Ask the Business Agent" aria-label="Ask the Business Agent">
                <svg class="o_agent_ai_icon" viewBox="-12 -12 24 24" aria-hidden="true">
                    <defs>
                        <!-- lighter than the avatar's gradient so it stands out on the dark navbar -->
                        <linearGradient id="o_agent_ai_grad" x1="-1" y1="1" x2="1" y2="-1">
                            <stop offset="0" stop-color="#8ab4f8"/>
                            <stop offset="0.55" stop-color="#c58af9"/>
                            <stop offset="1" stop-color="#ff9aa2"/>
                        </linearGradient>
                    </defs>
                    <path fill="url(#o_agent_ai_grad)" d="M0 -11 C1 -4 4 -1 11 0 C4 1 1 4 0 11 C-1 4 -4 1 -11 0 C-4 -1 -1 -4 0 -11 Z"/>
                </svg>
            </button>
        </div>
    </t>
</templates>
