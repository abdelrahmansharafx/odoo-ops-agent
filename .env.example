# --- Odoo (matches docker-compose defaults; demo data only) ---
ODOO_URL=http://localhost:8069
ODOO_DB=odoo
ODOO_USER=admin
ODOO_PASSWORD=admin

# --- LLM provider: set ONE key (if both are set, LLM_PROVIDER decides; default anthropic) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# LLM_PROVIDER=anthropic|openai|gemini
# LLM_MODEL=              # optional override
# JUDGE_MODEL=            # optional override for evals/run.py
